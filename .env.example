# ---------------------------------------------------------------------------
# پیش‌فرض: دیتابیس لوکال SQLite (نیازی به تنظیم چیزی نیست)
# فایل دیتابیس در ./data/shenskho.db ساخته می‌شود.
# ---------------------------------------------------------------------------
# DATABASE_URL=file:./data/shenskho.db

# ---------------------------------------------------------------------------
# برای دیتابیس ابری (Neon / Supabase / Vercel Postgres) این خط را باز کن:
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# منطقه‌ی زمانی برای محاسبه‌ی «امروز»
TZ=Asia/Tehran

# ---------------------------------------------------------------------------
# قفل ورود با رمز مشترک (اختیاری). اگر این خط را باز نکنی، قفل غیرفعال است
# و هرکسی که آدرس اپ را داشته باشد بدون رمز وارد می‌شود — برای دیپلوی روی
# اینترنت (Vercel) حتماً یک رمز قوی اینجا بگذار.
# ---------------------------------------------------------------------------
# APP_PASSWORD=یک-رمز-قوی-اینجا
